{
  "name": "@solaria/spike-prime",
  "version": "0.1.0-alpha.0",
  "description": "TypeScript SSP client for LEGO SPIKE Prime over Web Bluetooth — Solaria platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
